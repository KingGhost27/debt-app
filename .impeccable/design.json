      "refersTo": "plank-heading",
      "description": "Wooden tab that opens every module and dialog.",
      "html": "<span class=\"ds-plank\">Your debts</span>",
      "css": ":host{--ranch-ground:#F5EFFA;--ranch-page:#FFFCFF;--ranch-page2:#F0E8F8;--ranch-line:#E0D3EE;--ranch-track:#E7DCF3;--ranch-ink:#2B1A4F;--ranch-ink2:#5B4A7F;--ranch-btn-bg:#3A2466;--ranch-btn-fg:#FFFFFF;--ranch-btn-sh:rgb(58 36 102 / .32);--ranch-focus:#B1335F;--ranch-focus-bg:#FBE4EC;--ranch-ok-ink:#1D6A45;--ranch-ok-bg:#D6F1E1;--ranch-soon-ink:#694700;--ranch-soon-bg:#FBE9AE;--ranch-fill:#7B58C9;--ranch-sh:rgb(70 40 130 / .16);--ranch-plank:#84593F;--ranch-plank-ink:#FFF5EC;--ranch-ring:#2B1A4F} .ds-plank{display:inline-flex;align-items:center;gap:9px;padding:7px 15px 7px 13px;border-radius:7px 9px 8px 10px;background:var(--ranch-plank);color:var(--ranch-plank-ink);font:600 18px/1.15 Fredoka,sans-serif;border-bottom:3px solid rgb(0 0 0 / .16);box-shadow:0 6px 12px -8px var(--ranch-sh)} .ds-plank::before,.ds-plank::after{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.55}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The theme-colored pill for the one main action.",
      "html": "<button class=\"ds-btn-primary\">Log a payment</button>",
      "css": ":host{--ranch-ground:#F5EFFA;--ranch-page:#FFFCFF;--ranch-page2:#F0E8F8;--ranch-line:#E0D3EE;--ranch-track:#E7DCF3;--ranch-ink:#2B1A4F;--ranch-ink2:#5B4A7F;--ranch-btn-bg:#3A2466;--ranch-btn-fg:#FFFFFF;--ranch-btn-sh:rgb(58 36 102 / .32);--ranch-focus:#B1335F;--ranch-focus-bg:#FBE4EC;--ranch-ok-ink:#1D6A45;--ranch-ok-bg:#D6F1E1;--ranch-soon-ink:#694700;--ranch-soon-bg:#FBE9AE;--ranch-fill:#7B58C9;--ranch-sh:rgb(70 40 130 / .16);--ranch-plank:#84593F;--ranch-plank-ink:#FFF5EC;--ranch-ring:#2B1A4F} .ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 26px;border:0;border-radius:999px;font:600 17px/1 Fredoka,sans-serif;cursor:pointer;background:var(--ranch-btn-bg);color:var(--ranch-btn-fg);box-shadow:0 14px 24px -14px var(--ranch-btn-sh),0 3px 6px -2px var(--ranch-btn-sh);transition:transform .2s cubic-bezier(.16,1,.3,1)} .ds-btn-primary:hover{transform:translateY(-2px)} .ds-btn-primary:active{transform:translateY(1px)} .ds-btn-primary:focus-visible{outline:3px solid var(--ranch-ink);outline-offset:3px}"
    },
