      "css": ":host{--ranch-ground:#F5EFFA;--ranch-page:#FFFCFF;--ranch-page2:#F0E8F8;--ranch-line:#E0D3EE;--ranch-track:#E7DCF3;--ranch-ink:#2B1A4F;--ranch-ink2:#5B4A7F;--ranch-btn-bg:#3A2466;--ranch-btn-fg:#FFFFFF;--ranch-btn-sh:rgb(58 36 102 / .32);--ranch-focus:#B1335F;--ranch-focus-bg:#FBE4EC;--ranch-ok-ink:#1D6A45;--ranch-ok-bg:#D6F1E1;--ranch-soon-ink:#694700;--ranch-soon-bg:#FBE9AE;--ranch-fill:#7B58C9;--ranch-sh:rgb(70 40 130 / .16);--ranch-plank:#84593F;--ranch-plank-ink:#FFF5EC;--ranch-ring:#2B1A4F} .ds-lab{display:grid;gap:6px;font:700 14px/1.3 Quicksand,sans-serif;color:var(--ranch-ink)} .ds-in{min-height:48px;padding:10px 14px;border:2px solid var(--ranch-line);border-radius:14px;background:var(--ranch-page);color:var(--ranch-ink);font:600 16px/1.3 Nunito,sans-serif} .ds-in:hover{border-color:var(--ranch-ink2)} .ds-in:focus{outline:none;border-color:var(--ranch-ink);box-shadow:0 0 0 4px color-mix(in srgb,var(--ranch-ink) 22%,transparent)}"
    },
    {
      "name": "Segmented Control",
