      "html": "<div class=\"ds-row\"><span class=\"ds-rk\">2</span><div><div class=\"ds-dn\">Store card</div><div class=\"ds-dm\">26.99% APR · min $35</div></div><div class=\"ds-am\">$640</div><span class=\"ds-tr\"><i></i></span></div>",
      "css": ":host{--ranch-ground:#F5EFFA;--ranch-page:#FFFCFF;--ranch-page2:#F0E8F8;--ranch-line:#E0D3EE;--ranch-track:#E7DCF3;--ranch-ink:#2B1A4F;--ranch-ink2:#5B4A7F;--ranch-btn-bg:#3A2466;--ranch-btn-fg:#FFFFFF;--ranch-btn-sh:rgb(58 36 102 / .32);--ranch-focus:#B1335F;--ranch-focus-bg:#FBE4EC;--ranch-ok-ink:#1D6A45;--ranch-ok-bg:#D6F1E1;--ranch-soon-ink:#694700;--ranch-soon-bg:#FBE9AE;--ranch-fill:#7B58C9;--ranch-sh:rgb(70 40 130 / .16);--ranch-plank:#84593F;--ranch-plank-ink:#FFF5EC;--ranch-ring:#2B1A4F} .ds-row{display:grid;grid-template-columns:30px 1fr auto;gap:6px 12px;align-items:center;padding:14px 0;color:var(--ranch-ink);width:360px} .ds-rk{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--ranch-focus);color:var(--ranch-page);font:700 13px/1 Quicksand,sans-serif} .ds-dn{font:600 17px/1.25 Fredoka,sans-serif} .ds-dm{font:600 13.5px/1.35 Nunito,sans-serif;color:var(--ranch-ink2)} .ds-am{font:700 21px/1.1 Quicksand,sans-serif;font-variant-numeric:tabular-nums} .ds-tr{grid-column:2/4;height:9px;border-radius:999px;background:var(--ranch-track);overflow:hidden} .ds-tr i{display:block;width:47%;height:100%;border-radius:999px;background:var(--ranch-focus)}"
    }
